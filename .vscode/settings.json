            "driver": "MySQL",
            "name": "MySQL Local",
            "database": "AI",
            "username": "root",
            "password": "Tanisha@1105",
            "connectionTimeout": 30
        },
        {
            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "localhost",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "PG Local",
