{
    "files.associations": {
        "*.html": "jinja-html"
    },
    "emmet.includeLanguages": {
        "jinja-html": "html"
    },
    "html.validate.scripts": false,
    "javascript.validate.enable": false,
    "[html]": {
        "editor.suggest.insertMode": "replace"
    },
    "html.format.templating": true,
    "html.customData": [
        ".vscode/html.html-data.json"
    ],
    "sqltools.connections": [
